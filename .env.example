# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stocksentry

# Shopify Partner app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_inventory,read_products,read_locations
# Use SHOPIFY_BILLING_TEST=true until live App Store billing
SHOPIFY_BILLING_TEST=true

# Public URLs
# API origin (OAuth + webhooks + /api)
APP_URL=https://localhost:4000
# Embedded Next.js admin UI
EMBEDDED_APP_URL=https://localhost:3000
# Browser → API (often same as APP_URL behind Nginx)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SHOPIFY_API_KEY=

# OpenAI / AI reports (optional — reports fall back without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MONTHLY_REPORT_LIMIT=50

# App runtime
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=4000
WEB_PORT=3000
