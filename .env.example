# Database
DATABASE_URL=postgresql://stocksentry:CHANGE_ME@localhost:5432/stocksentry

# Shopify Partner app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_inventory,read_products,read_locations
# Use SHOPIFY_BILLING_TEST=true until live App Store billing
SHOPIFY_BILLING_TEST=true

# Public URLs
APP_URL=https://stocksentry.tidyflowapp.com
EMBEDDED_APP_URL=https://stocksentry.tidyflowapp.com
NEXT_PUBLIC_API_URL=https://stocksentry.tidyflowapp.com
NEXT_PUBLIC_SHOPIFY_API_KEY=
ADMIN_APP_URL=https://stocksentry.tidyflowapp.com/admin

# Multi-provider AI (fallback order: groq → gemini → openai → claude)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest
AI_PROVIDER_ORDER=groq,gemini,openai,claude
AI_MONTHLY_REPORT_LIMIT=50

# Admin panel (Next @stocksentry/admin on :6082, basePath /admin)
# Boot sync upserts OWNER AdminUser from ADMIN_EMAIL/ADMIN_PASSWORD when set.
ADMIN_JWT_SECRET=change-me-long-random
ADMIN_JWT_TTL_HOURS=12
ADMIN_EMAIL=admin@stocksentry.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_BOOTSTRAP_SECRET=
ADMIN_PORT=6082

# Email delivery (Resend preferred; SMTP fallback; else deliveries fail with NO_EMAIL_PROVIDER)
RESEND_API_KEY=
EMAIL_FROM=StockSentry <noreply@stocksentry.tidyflowapp.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App runtime
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=6081
WEB_PORT=6080
# Keep one secrets file at monorepo root; ecosystem.config.cjs + api/worker dotenv load it.
